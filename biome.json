{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "!src/lib/bindings.ts",
      "!src/routeTree.gen.ts",
      "vite.config.ts",
      "lingui.config.ts",
      "package.json",
      "tsconfig.json",
      "tsconfig.node.json",
      "biome.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "tailwind": {
    "stylesheet": "./src/index.css"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useTailwindSortedClasses": "warn",
        "useTailwindShorthandClasses": "warn",
        "noTailwindLegacyUtilities": "warn",
        "noTailwindRawColors": "error",
        "useTailwindStaticClassStrings": "error"
      },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": [
              "NativeSelect"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/components/assistant-ui/elements/**"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useTailwindSortedClasses": "off",
            "noTailwindRawColors": "off",
            "noTailwindLegacyUtilities": "off",
            "useTailwindShorthandClasses": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "a11y": {
            "noStaticElementInteractions": "off",
            "useAriaPropsSupportedByRole": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/ui/**",
        "src/components/assistant-ui/elements/**"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noTailwindRawColors": "off"
          }
        }
      }
    }
  ]
}
