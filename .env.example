# CLI 加载当前目录 .env；已有环境变量优先。库使用显式配置。
# 后端选择：local / glm / minimax；未设置时兼容默认 glm，--backend 优先。
MODEL_BACKEND=local
LOCAL_MODEL=default
LOCAL_API_BASE_URL=http://127.0.0.1:1234/v1/
# 以下仅在 MODEL_BACKEND=glm 时使用。
MODEL=bigmodel::glm-4.6
API_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/
BIGMODEL_API_KEY=replace-with-your-key
# 显式思考预算，CLI --reasoning-effort 优先；依模型能力支持。
REASONING_EFFORT=low
# 输出传输方式：tool / json / schema；是否约束成功需按端点验证。
OUTPUT_MODE=json
# 以下仅在 MODEL_BACKEND=minimax 时使用；不采用 GLM 的思考和输出配置。
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_API_BASE_URL=https://api.minimax.cn/v1/
MINIMAX_API_KEY=replace-with-your-key
