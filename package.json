{
  "name": "castglean",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:ai": "vitest run tests/unit/ai-stream.test.mjs tests/unit/ai-transport.test.mjs tests/unit/ai-pending-starts.test.mjs tests/unit/ai-components.test.mjs tests/unit/split-review.test.mjs",
    "test:source": "vitest run tests/unit/source-window.test.mjs tests/unit/source-whitespace.test.mjs",
    "test:playback": "vitest run tests/unit/voice-playback.test.mjs tests/unit/voice-audition.test.mjs tests/unit/voice-candidate.test.mjs tests/unit/chapter-audio.test.mjs",
    "test:binding": "vitest run tests/unit/binding-operations.test.mjs",
    "test:audition": "vitest run tests/unit/audition-operations.test.mjs",
    "test:voice-import": "vitest run tests/unit/voice-import-validation.test.mjs",
    "test:tailwind": "vitest run tests/unit/tailwind-rules.test.mjs tests/unit/visual-boundaries.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "i18n:extract": "lingui extract",
    "lint": "biome lint . && node scripts/check-visual-boundaries.mjs",
    "format": "biome format --write .",
    "test:logging": "vitest run tests/unit/frontend-log.test.mjs",
    "desktop:dev": "tauri dev --config src-tauri/tauri.mcp.conf.json",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.167",
