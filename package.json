    "@fontsource-variable/playfair-display": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@lingui/core": "^6.11.0",
    "@lingui/react": "^6.11.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-hotkeys": "^0.23.1",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "ai": "^7.0.163",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "pretty-bytes": "^7.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.92.0",
    "shadcn": "^4.23.0",
    "streamdown": "2.7.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wavesurfer.js": "^8.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.12",
    "@biomejs/biome": "^2.6.4",
    "@lingui/babel-plugin-lingui-macro": "^6.11.0",
    "@lingui/cli": "^6.11.0",
    "@lingui/format-po": "^6.11.0",
    "@lingui/vite-plugin": "^6.11.0",
    "@playwright/test": "^1.65.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "color-name": "^1.1.4",
    "postcss": "^8.5.32",
    "postcss-value-parser": "^4.2.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
